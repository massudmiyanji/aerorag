# Copy to .env and change what you need. Every variable is optional.
AERORAG_QDRANT_URL=http://localhost:6333
AERORAG_QDRANT_COLLECTION=aerorag_chunks
AERORAG_OLLAMA_BASE_URL=http://localhost:11434
AERORAG_LLM_MODEL=qwen3:4b
AERORAG_EMBEDDING_MODEL=BAAI/bge-m3
AERORAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AERORAG_CHUNK_SIZE_TOKENS=512
AERORAG_CHUNK_OVERLAP_TOKENS=64
AERORAG_RETRIEVE_TOP_K=20
AERORAG_RERANK_TOP_N=5
AERORAG_RERANK_SCORE_THRESHOLD=0.0
AERORAG_DATA_DIR=data
AERORAG_LOG_LEVEL=INFO
